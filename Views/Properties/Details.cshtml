@model HostProperty
@{ViewData["Title"]=Model.Title;}
<a class="back-link" asp-controller="Home" asp-action="Index">← Back to stays</a><div class="details-head"><div><p class="eyebrow">@Model.City · @Model.PropertyType</p><h1>@Model.Title</h1><p class="muted">@Model.Address</p></div><div class="price-large"><strong>R @Model.PricePerNight.ToString("N2")</strong><span>/ night</span></div></div><div class="gallery">@foreach(var img in Model.Images){<img src="@img.ImageUrl" alt="Photo of @Model.Title"/>}</div><div class="details-columns"><section><h2>About this place</h2><p class="description">@Model.Description</p><p>Up to @Model.Capacity guests · @Model.PropertyType</p>@if(Model.PropertyAmenities.Any()){<h3>What this place offers</h3><ul>@foreach(var a in Model.PropertyAmenities){<li>@a.Amenity?.Name</li>}</ul>}</section><aside class="booking-box"><h2>Plan your stay</h2><p><strong>R @Model.PricePerNight.ToString("N2")</strong> per night</p><p class="muted">Cleaning fee: R @Model.CleaningFee.ToString("N2")<br/>Service fee: R @Model.ServiceFee.ToString("N2")</p>@if(User.IsInRole("Guest")){<a class="button primary full" asp-controller="Bookings" asp-action="Create" asp-route-propertyId="@Model.Id">Reserve this stay</a>}else if(User.Identity?.IsAuthenticated!=true){<a class="button primary full" asp-controller="Account" asp-action="Login">Log in to book</a>}else{<p class="muted">Booking is available to Guest accounts.</p>}</aside></div>