@model IEnumerable<Booking>
@{ViewData["Title"]="My trips";}<p class="eyebrow">YOUR TRAVEL PLANS</p><h1>My trips</h1>@if(!Model.Any()){<div class="empty-state"><h3>Your next adventure starts here</h3><p>Explore stays and request your first booking.</p><a class="button primary" asp-controller="Home" asp-action="Index">Explore stays</a></div>}else{<div class="stack">@foreach(var b in Model){<article class="list-card"><div>@if(b.Property?.Images.FirstOrDefault() is PropertyImage img){<img class="thumb" src="@img.ImageUrl" alt="Property photo"/>}</div><div class="grow"><h3>@b.Property?.Title</h3><p class="muted">@b.CheckInDate.ToString("dd MMM yyyy") – @b.CheckOutDate.ToString("dd MMM yyyy") · @b.NumberOfGuests guest(s)</p><p><strong>R @b.TotalPrice.ToString("N2")</strong></p></div><span class="status @b.Status.ToString().ToLowerInvariant()">@b.Status</span><a asp-action="Details" asp-route-id="@b.Id">Details</a></article>}</div>}