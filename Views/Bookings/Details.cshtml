@model Booking
@{ViewData["Title"]="Booking details";}<p class="eyebrow">BOOKING #@Model.Id</p><h1>@Model.Property?.Title</h1><span class="status @Model.Status.ToString().ToLowerInvariant()">@Model.Status</span><div class="details-columns"><section class="form-card"><h2>Your dates</h2><p>@Model.CheckInDate.ToString("dd MMM yyyy") – @Model.CheckOutDate.ToString("dd MMM yyyy")</p><p>@Model.NumberOfGuests guest(s)</p><h2>Price breakdown</h2><p>R @Model.PricePerNightAtBooking.ToString("N2") × @((Model.CheckOutDate.Date-Model.CheckInDate.Date).Days) nights = R @Model.AccommodationSubtotal.ToString("N2")</p><p>Cleaning fee: R @Model.CleaningFeeAtBooking.ToString("N2")</p><p>Service fee: R @Model.ServiceFeeAtBooking.ToString("N2")</p><hr/><h3>Total: R @Model.TotalPrice.ToString("N2")</h3>@if(Model.Status==WorkflowStatus.Approved){<a class="button primary" asp-controller="CheckIn" asp-action="Index" asp-route-bookingId="@Model.Id">Complete check-in</a>}</section></div>