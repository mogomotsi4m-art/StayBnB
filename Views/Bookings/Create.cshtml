@model BookingViewModel
@{ViewData["Title"]="Reserve a stay";}<div class="form-shell"><p class="eyebrow">YOUR NEXT STAY</p><h1>Request a booking</h1><form asp-action="Create" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="PropertyId" type="hidden"/><label asp-for="CheckInDate">Check-in</label><input asp-for="CheckInDate" type="date"/><span asp-validation-for="CheckInDate" class="validation"></span><label asp-for="CheckOutDate">Check-out</label><input asp-for="CheckOutDate" type="date"/><span asp-validation-for="CheckOutDate" class="validation"></span><label asp-for="NumberOfGuests">Number of guests</label><input asp-for="NumberOfGuests" type="number" min="1" max="50"/><button class="button primary full">Request booking</button><p class="muted small">Your final price is calculated and stored when the booking request is created. The Host must approve it.</p></form></div>