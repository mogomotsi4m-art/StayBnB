@model IEnumerable<HostProperty>
@{ViewData["Title"]="Find your stay";}
<section class="hero"><p class="eyebrow">STAYS THAT FEEL LIKE YOURS</p><h1>Find a place to <em>belong.</em></h1><p>Thoughtful homes for your next little adventure.</p><form method="get" class="search-bar"><label>City<input name="city" value="@ViewBag.City" placeholder="Cape Town, Durban…" /></label><label>Property type<select name="propertyType"><option value="">All types</option>@foreach(var t in (IEnumerable<string>)ViewBag.PropertyTypes){<option selected="@(ViewBag.PropertyType==t)" value="@t">@t</option>}</select></label><button class="button primary">Search stays</button></form></section>
<div class="section-heading"><div><p class="eyebrow">CURATED FOR YOU</p><h2>Explore stays</h2></div><span class="muted">@Model.Count() stays found</span></div><div class="property-grid">@foreach(var p in Model){<a class="property-card" asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id"><div class="property-image">@if((p.Images.FirstOrDefault(i=>i.IsPrimary)??p.Images.FirstOrDefault()) is PropertyImage image){<img src="@image.ImageUrl" alt="@p.Title"/>}else{<div class="image-placeholder">staybnb</div>}<span class="type-tag">@p.PropertyType</span></div><div class="card-info"><div class="card-title"><h3>@p.Title</h3><span>@p.City</span></div><p class="muted">@p.Description</p><p><strong>R @p.PricePerNight.ToString("N2")</strong> <span class="muted">/ night</span></p></div></a>}</div>@if(!Model.Any()){<div class="empty-state"><h3>No stays match those filters yet</h3><p>Try another city or property type.</p><a asp-action="Index" class="button secondary">Clear filters</a></div>}