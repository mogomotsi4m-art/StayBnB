@model PropertyApplicationViewModel
@{ViewData["Title"]="Become a host";}<div class="form-shell wide"><p class="eyebrow">SHARE YOUR SPACE</p><h1>Become a Staybnb host</h1><p class="muted">Tell us about the place you want to welcome guests into. At least one property photo is required.</p><form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="Title">Property title</label><input asp-for="Title"/><span asp-validation-for="Title" class="validation"></span></div><div><label asp-for="PropertyType">Property type</label><select asp-for="PropertyType"><option>Apartment</option><option>House</option><option>Guesthouse</option><option>Cabin</option><option>Room</option><option>Villa</option></select></div><div><label asp-for="PricePerNight">Price per night (R)</label><input asp-for="PricePerNight" type="number" step="0.01" min="1"/></div><div><label asp-for="Capacity">Guest capacity</label><input asp-for="Capacity" type="number" min="1" max="50"/></div><div><label asp-for="CleaningFee">Cleaning fee (R)</label><input asp-for="CleaningFee" type="number" step="0.01" min="0"/></div><div><label asp-for="ServiceFee">Service fee (R)</label><input asp-for="ServiceFee" type="number" step="0.01" min="0"/></div><div class="span-two"><label asp-for="Address">Street address</label><input asp-for="Address"/></div><div><label asp-for="City"></label><input asp-for="City"/></div><div class="span-two"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="span-two"><label for="Images">Property photos (JPG, PNG or WEBP; max 5 MB each)</label><input name="Images" id="Images" type="file" accept="image/jpeg,image/png,image/webp" multiple required/><span asp-validation-for="Images" class="validation"></span></div></div><p class="muted small">Applications are reviewed by an Admin. Your listing stays inactive until approval.</p><button class="button primary">Submit application</button></form></div>