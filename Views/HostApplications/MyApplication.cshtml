@model IEnumerable<HostApplication>
@{ViewData["Title"]="My host applications";}<div class="section-heading"><div><p class="eyebrow">YOUR HOST JOURNEY</p><h1>My applications</h1></div><a class="button primary" asp-action="Create">New application</a></div>@if(!Model.Any()){<div class="empty-state"><h3>No applications yet</h3><p>Have a space to share? Start your host application.</p><a class="button primary" asp-action="Create">Become a host</a></div>}else{<div class="stack">@foreach(var a in Model){<article class="list-card"><div>@if(a.Property?.Images.FirstOrDefault() is PropertyImage img){<img class="thumb" src="@img.ImageUrl" alt="Property photo"/>}</div><div class="grow"><h3>@a.Property?.Title</h3><p class="muted">Submitted @a.AppliedAt.ToLocalTime().ToString("dd MMM yyyy") · @a.Property?.City</p>@if(a.ReviewNote!=null){<p>@a.ReviewNote</p>}</div><span class="status @a.Status.ToString().ToLowerInvariant()">@a.Status</span></article>}</div>}