@model IEnumerable<Notification>
@{ViewData["Title"]="Notifications";}<p class="eyebrow">YOUR STAYBNB UPDATES</p><h1>Notifications</h1>@if(!Model.Any()){<div class="empty-state"><h3>All caught up</h3><p>Important booking and account updates will appear here.</p></div>}else{<div class="stack">@foreach(var n in Model){<article class="list-card"><div class="grow"><h3>@n.Title @if(!n.IsRead){<span class="status pending">New</span>}</h3><p class="muted">@n.Type · @n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@n.Id"/><button class="button secondary">@(n.IsRead?"Open":"Mark read & open")</button></form></article>}</div>}