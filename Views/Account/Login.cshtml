@model LoginViewModel
@{ViewData["Title"]="Log in";}<div class="form-shell"><p class="eyebrow">GOOD TO HAVE YOU BACK</p><h1>Log in to Staybnb</h1><form asp-action="Login" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="Email"></label><input asp-for="Email"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Password"></label><input asp-for="Password"/><span asp-validation-for="Password" class="validation"></span><label class="check-label"><input asp-for="RememberMe"/> Remember me</label><button class="button primary full">Log in</button></form><p class="center">New here? <a asp-action="Register">Create an account</a></p></div>