@model RegisterViewModel
@{ViewData["Title"]="Create account";}<div class="form-shell"><p class="eyebrow">WELCOME TO STAYBNB</p><h1>Create your account</h1><p class="muted">Join as a Guest. You can apply to become a Host later.</p><form asp-action="Register" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="FullName">Full name</label><input asp-for="FullName"/><span asp-validation-for="FullName" class="validation"></span><label asp-for="Email"></label><input asp-for="Email"/><span asp-validation-for="Email" class="validation"></span><label asp-for="Password"></label><input asp-for="Password"/><span asp-validation-for="Password" class="validation"></span><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword"/><span asp-validation-for="ConfirmPassword" class="validation"></span><button class="button primary full">Create account</button></form><p class="center">Already have an account? <a asp-action="Login">Log in</a></p></div>