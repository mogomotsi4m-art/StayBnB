@model HostPropertyEditViewModel
@{ViewData["Title"]="Edit property";}<div class="form-shell wide"><p class="eyebrow">YOUR LISTING</p><h1>Edit property</h1><form asp-action="EditProperty" method="post" enctype="multipart/form-data" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><input asp-for="Id" type="hidden"/><div class="form-grid"><div><label asp-for="Title"></label><input asp-for="Title"/><span asp-validation-for="Title" class="validation"></span></div><div><label asp-for="PropertyType"></label><select asp-for="PropertyType"><option>Apartment</option><option>House</option><option>Guesthouse</option><option>Cabin</option><option>Room</option><option>Villa</option></select></div><div><label asp-for="PricePerNight">Price per night (R)</label><input asp-for="PricePerNight" type="number" step="0.01" min="1"/></div><div><label asp-for="Capacity"></label><input asp-for="Capacity" type="number" min="1" max="50"/></div><div><label asp-for="CleaningFee">Cleaning fee (R)</label><input asp-for="CleaningFee" type="number" step="0.01" min="0"/></div><div><label asp-for="ServiceFee">Service fee (R)</label><input asp-for="ServiceFee" type="number" step="0.01" min="0"/></div><div class="span-two"><label asp-for="Address"></label><input asp-for="Address"/></div><div><label asp-for="City"></label><input asp-for="City"/></div><div class="span-two"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea></div><div class="span-two"><label asp-for="NewImages">Add more photos (optional)</label><input asp-for="NewImages" type="file" accept="image/jpeg,image/png,image/webp" multiple/></div></div><button class="button primary">Save changes</button></form></div>