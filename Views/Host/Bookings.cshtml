@model IEnumerable<Booking>
@{ViewData["Title"]="Host bookings";}<p class="eyebrow">GUEST STAYS</p><h1>Booking requests</h1><p><a asp-action="Index">← Dashboard</a></p>@if(!Model.Any()){<div class="empty-state"><h3>No bookings yet</h3></div>}else{<div class="stack">@foreach(var b in Model){<article class="list-card"><div class="grow"><h3>@b.Property?.Title</h3><p>@(b.Guest?.FullName??b.Guest?.Email) · @b.NumberOfGuests guest(s)</p><p class="muted">@b.CheckInDate.ToString("dd MMM yyyy") – @b.CheckOutDate.ToString("dd MMM yyyy")</p><p>R @b.TotalPrice.ToString("N2")</p></div><span class="status @b.Status.ToString().ToLowerInvariant()">@b.Status</span>@if(b.Status==WorkflowStatus.Pending){<form asp-action="DecideBooking" method="post" class="inline"><input type="hidden" name="id" value="@b.Id"/><button class="button primary" name="decision" value="approve">Approve</button><button class="button danger" name="decision" value="reject">Reject</button></form>}@if(b.Status==WorkflowStatus.Approved){<a asp-controller="Host" asp-action="Documents" asp-route-bookingId="@b.Id">Review check-in</a>}</article>}}</div>}