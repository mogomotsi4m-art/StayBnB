@model IEnumerable<GuestDocument>
@{ViewData["Title"]="Guest documents";}<p class="eyebrow">PRIVATE GUEST DOCUMENTS</p><h1>Check-in verification</h1><p class="muted">Only documents for bookings on your own properties are shown. Downloaded documents must be handled securely and deleted when no longer needed.</p><div class="stack">@foreach(var d in Model){<article class="list-card"><div class="grow"><h3>@d.DocumentType · Booking #@d.GuestCheckin?.BookingId</h3><p>@d.GuestCheckin?.Booking?.Property?.Title · @(d.GuestCheckin?.Booking?.Guest?.Email)</p><p class="muted">Uploaded @d.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><span class="status @d.Status.ToString().ToLowerInvariant()">@d.Status</span>@if(d.Status==WorkflowStatus.Submitted){<div class="button-row"><a class="button secondary" asp-controller="CheckIn" asp-action="DownloadDocument" asp-route-id="@d.Id">Download</a><form asp-controller="CheckIn" asp-action="ReviewDocument" method="post"><input type="hidden" name="id" value="@d.Id"/><button class="button primary" name="decision" value="verify">Verify</button><button class="button danger" name="decision" value="reject">Needs correction</button></form></div>}</article>}</div>