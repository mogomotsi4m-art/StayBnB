@model IEnumerable<HostProperty>
@{ViewData["Title"]="Host dashboard";}<p class="eyebrow">YOUR HOST SPACE</p><h1>Host dashboard</h1><div class="stats-grid"><div class="stat-card"><span>Properties</span><strong>@ViewBag.Properties</strong></div><div class="stat-card"><span>Active listings</span><strong>@ViewBag.Active</strong></div><div class="stat-card"><span>Pending requests</span><strong>@ViewBag.Pending</strong></div><div class="stat-card"><span>Approved bookings</span><strong>@ViewBag.Approved</strong></div></div><div class="section-heading"><h2>Your properties</h2><a class="button secondary" asp-action="CheckInProcesses">Check-in setup</a></div>@if(!Model.Any()){<div class="empty-state"><h3>Your approved properties will appear here</h3><p>Start by applying to host from your Guest account.</p></div>}else{<div class="property-grid">@foreach(var p in Model){<article class="property-card"><div class="property-image">@if(p.Images.FirstOrDefault() is PropertyImage img){<img src="@img.ImageUrl" alt="@p.Title"/>}</div><div class="card-info"><h3>@p.Title</h3><p class="muted">@p.City · R @p.PricePerNight.ToString("N2") / night</p><span class="status @(p.IsActive?"approved":"pending")">@(p.IsActive?"Active":"Inactive")</span><p><a asp-action="EditProperty" asp-route-id="@p.Id">Edit listing</a> · <a asp-action="ConfigureCheckIn" asp-route-propertyId="@p.Id">Configure check-in</a></p><form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="button secondary">@(p.IsActive?"Deactivate listing":"Activate listing")</button></form></div></article>}</div>}<p><a class="button primary" asp-action="Bookings">Manage booking requests</a></p>