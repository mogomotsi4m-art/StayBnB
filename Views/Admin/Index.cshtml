@{ViewData["Title"]="Admin dashboard";}<p class="eyebrow">PLATFORM OPERATIONS</p><h1>Admin dashboard</h1><div class="stats-grid"><div class="stat-card"><span>Total users</span><strong>@ViewBag.Users</strong></div><div class="stat-card"><span>Pending applications</span><strong>@ViewBag.Pending</strong></div><div class="stat-card"><span>Active properties</span><strong>@ViewBag.ActiveProperties</strong></div><div class="stat-card"><span>Pending bookings</span><strong>@ViewBag.PendingBookings</strong></div></div><div class="action-grid"><a class="action-card" asp-action="Applications"><strong>Host applications →</strong><span>Review and decide applications</span></a><a class="action-card" asp-action="Activity"><strong>Activity audit →</strong><span>Inspect logged system actions</span></a><a class="action-card" asp-action="Documents" asp-controller="Admin"><strong>Check-in documents →</strong><span>Document queue overview</span></a>@if(User.IsInRole("SuperAdmin")){<a class="action-card" asp-action="PromoteGuests"><strong>User role management →</strong><span>Promote eligible Guests to Admin</span></a>}</div><h2>Recent activity</h2><div class="table-wrap"><table><thead><tr><th>When</th><th>User</th><th>Action</th><th>Type</th></tr></thead><tbody>@foreach(var a in (IEnumerable<ActivityLog>)ViewBag.Recent){<tr><td>@a.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@(a.User?.Email??"System")</td><td>@a.Action</td><td>@a.ActivityType</td></tr>}</tbody></table></div>