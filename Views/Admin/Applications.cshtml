@model IEnumerable<HostApplication>
@{ViewData["Title"]="Host application review";}<p class="eyebrow">QUALITY & TRUST</p><h1>Host applications</h1><div class="stack">@foreach(var a in Model){<article class="review-card"><div class="review-images">@foreach(var img in a.Property!.Images){<img src="@img.ImageUrl" alt="Submitted property photo"/>}</div><div class="review-content"><div class="section-heading"><h2>@a.Property.Title</h2><span class="status @a.Status.ToString().ToLowerInvariant()">@a.Status</span></div><p><strong>Applicant:</strong> @a.Applicant?.FullName (@a.Applicant?.Email)</p><p>@a.Property.Address, @a.Property.City · @a.Property.PropertyType</p><p>@a.Property.Description</p><p>R @a.Property.PricePerNight.ToString("N2") / night · Capacity @a.Property.Capacity</p><p class="muted">Applied @a.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>@if(a.Status==WorkflowStatus.Pending){<form asp-action="ReviewApplication" method="post"><input type="hidden" name="id" value="@a.Id"/><label for="note-@a.Id">Review note (optional)</label><input id="note-@a.Id" name="note" maxlength="500"/><div class="button-row"><button class="button primary" name="decision" value="approve">Approve & make Host</button><button class="button danger" name="decision" value="reject">Reject</button></div></form>}</div></article>}</div>