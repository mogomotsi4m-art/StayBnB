@model IEnumerable<GuestDocument>
@{ViewData["Title"]="Check-in documents";}<p class="eyebrow">GUEST VERIFICATION</p><h1>Check-in documents</h1><p class="muted">Private documents are not shown publicly. Hosts can access only documents for bookings on their own properties.</p><div class="stack">@foreach(var d in Model){<article class="list-card"><div class="grow"><h3>@d.DocumentType · Booking #@d.GuestCheckin?.BookingId</h3><p>@d.GuestCheckin?.Booking?.Property?.Title · @(d.GuestCheckin?.Booking?.Guest?.Email)</p><p class="muted">Uploaded @d.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><span class="status @d.Status.ToString().ToLowerInvariant()">@d.Status</span></article>}</div>