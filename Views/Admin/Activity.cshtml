@model IEnumerable<ActivityLog>
@{ViewData["Title"]="Activity audit";}<p class="eyebrow">AUDIT TRAIL</p><h1>Activity log</h1><div class="table-wrap"><table><thead><tr><th>Timestamp</th><th>User</th><th>Type</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td><td>@(a.User?.Email??"System")</td><td>@a.ActivityType</td><td>@a.Action</td><td>@a.Details</td></tr>}</tbody></table></div>