@model IEnumerable<ApplicationUser>
@{ViewData["Title"]="Promote Guests";}<p class="eyebrow">SUPERADMIN CONTROL</p><h1>Promote a Guest to Admin</h1><p class="muted">This action is restricted to SuperAdmin accounts. Promoted users lose the Guest role.</p><div class="stack">@foreach(var u in Model){<article class="list-card"><div class="grow"><h3>@(u.FullName??u.Email)</h3><p class="muted">@u.Email</p></div><form asp-action="PromoteGuest" method="post"><input type="hidden" name="userId" value="@u.Id"/><button class="button primary" onclick="return confirm(&quot;Promote this user to Admin?&quot;)">Promote to Admin</button></form></article>}</div>