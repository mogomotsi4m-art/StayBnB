@model MessageViewModel
@{ViewData["Title"]="New message";}<div class="form-shell"><h1>Send a message</h1><form asp-action="Compose" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="validation"></div><label asp-for="ReceiverId">Recipient</label><select asp-for="ReceiverId" asp-items="(IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Users"><option value="">Choose a user</option></select><span asp-validation-for="ReceiverId" class="validation"></span><label asp-for="Content">Message</label><textarea asp-for="Content" rows="6"></textarea><span asp-validation-for="Content" class="validation"></span><button class="button primary full">Send message</button></form></div>