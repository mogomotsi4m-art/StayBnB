@model IEnumerable<Message>
@{ViewData["Title"]="Inbox";var uid=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;}<div class="section-heading"><div><p class="eyebrow">STAY IN TOUCH</p><h1>Inbox</h1></div><a class="button primary" asp-action="Compose">New message</a></div>@if(!Model.Any()){<div class="empty-state"><h3>Your inbox is quiet</h3><p>Messages about your stays will appear here.</p></div>}else{<div class="stack">@foreach(var m in Model){<article class="list-card"><div class="grow"><h3>@(m.SenderId==uid?"To: "+(m.Receiver?.FullName??m.Receiver?.Email):"From: "+(m.Sender?.FullName??m.Sender?.Email)) @if(m.ReceiverId==uid&&!m.IsRead){<span class="status pending">Unread</span>}</h3><p>@m.Content</p><p class="muted">@m.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div><div class="button-row"><a asp-action="Reply" asp-route-id="@m.Id">Reply</a>@if(m.ReceiverId==uid&&!m.IsRead){<form asp-action="MarkRead" method="post"><input type="hidden" name="id" value="@m.Id"/><button class="button secondary">Mark read</button></form>}</div></article>}</div>}