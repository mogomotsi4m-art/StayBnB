@model Booking
@{ViewData["Title"]="Guest check-in";var process=Model.Property?.CheckInProcess;var steps=process==null?new List<string>():System.Text.Json.JsonSerializer.Deserialize<List<string>>(process.StepsJson)??new();var docs=process==null?new List<string>{"ID or passport"}:System.Text.Json.JsonSerializer.Deserialize<List<string>>(process.RequiredDocumentsJson)??new();}
<p class="eyebrow">BEFORE YOU ARRIVE</p><h1>Check-in for @Model.Property?.Title</h1><p class="muted">Booking #@Model.Id · @Model.CheckInDate.ToString("dd MMM yyyy")</p><div class="form-card"><h2>@process?.Title</h2><ol>@foreach(var step in steps){<li>@step</li>}</ol><h3>Required documents</h3><ul>@foreach(var d in docs){<li>@d</li>}</ul><hr/><h3>Upload a document for Host verification</h3><form asp-action="Upload" method="post" enctype="multipart/form-data"><input type="hidden" name="bookingId" value="@Model.Id"/><label for="documentType">Document type</label><select id="documentType" name="documentType"><option>ID card</option><option>Passport</option><option>Proof of identity</option></select><label for="file">Document (PDF, JPG or PNG; max 5 MB)</label><input id="file" name="file" type="file" accept="application/pdf,image/jpeg,image/png" required/><button class="button primary">Submit for verification</button></form><h3>Submitted documents</h3>@if(Model.GuestCheckin?.Documents.Any()==true){<ul>@foreach(var d in Model.GuestCheckin.Documents){<li>@d.DocumentType — <span class="status @d.Status.ToString().ToLowerInvariant()">@d.Status</span></li>}</ul>}else{<p class="muted">No documents submitted yet.</p>}</div>