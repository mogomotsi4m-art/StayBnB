<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Staybnb</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head><body><header class="site-header"><a class="brand" asp-controller="Home" asp-action="Index">staybnb<span>.</span></a><nav><a asp-controller="Home" asp-action="Index">Explore</a>@if(User.IsInRole("Guest")){<a asp-controller="HostApplications" asp-action="Create">Become a host</a><a asp-controller="Bookings" asp-action="Mine">My trips</a>}@if(User.IsInRole("Host")){<a asp-controller="Host" asp-action="Index">Host dashboard</a>}@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-controller="Admin" asp-action="Index">Admin</a>}@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Messages" asp-action="Index">Inbox</a><a asp-controller="Notifications" asp-action="Index">Notifications</a><form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button class="nav-button">Log out</button></form>}else{<a asp-controller="Account" asp-action="Login">Log in</a><a class="pill-link" asp-controller="Account" asp-action="Register">Sign up</a>}</nav></header><main class="container">@if(TempData["Error"]!=null){<div class="alert error">@TempData["Error"]</div>}@if(TempData["Success"]!=null){<div class="alert success">@TempData["Success"]</div>}@RenderBody()</main><footer>Staybnb · Find your place, feel at home.</footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>